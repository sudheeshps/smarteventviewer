<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- 
    Solution-level target hook to incrementally copy DotNetDupe runtime DLLs
    (DotNetDupe.dll, libcrypto-4-x64.dll, libssl-4-x64.dll) into $(OutDir) for all projects.
  -->
  <Target Name="CopyDotNetDupeNativeBinaries" AfterTargets="Build">
    <PropertyGroup>
      <DotNetDupeArch Condition="'$(Platform)' == 'x64' OR '$(Platform)' == 'AnyCPU'">win-x64</DotNetDupeArch>
      <DotNetDupeArch Condition="'$(Platform)' == 'Win32' OR '$(Platform)' == 'x86'">win-x86</DotNetDupeArch>
    </PropertyGroup>
    
    <ItemGroup>
      <DotNetDupeNativeDlls Include="$(SolutionDir)DotNetDupe.3.0.2\runtimes\$(DotNetDupeArch)\native\*.dll" />
      <DotNetDupeNativeDlls Include="$(NuGetPackageRoot)\dotnetdupe\**\runtimes\$(DotNetDupeArch)\native\*.dll" />
      <DotNetDupeNativeDlls Include="$(USERPROFILE)\.nuget\packages\dotnetdupe\**\runtimes\$(DotNetDupeArch)\native\*.dll" />
      <DotNetDupeNativeDlls Include="D:\AppData\NuGet\packages\dotnetdupe\**\runtimes\$(DotNetDupeArch)\native\*.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(DotNetDupeNativeDlls)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>

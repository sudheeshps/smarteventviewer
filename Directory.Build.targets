<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- 
    Solution-level target hook to copy DotNetDupe and vcpkg runtime DLLs
    (DotNetDupe.dll, libcrypto-4-x64.dll, libssl-4-x64.dll, llama.dll, ggml.dll, etc.) into $(OutDir) for all projects.
  -->
  <Target Name="CopyRuntimeDependencies" AfterTargets="Build">
    <PropertyGroup>
      <DotNetDupeArch Condition="'$(Platform)' == 'x64' OR '$(Platform)' == 'AnyCPU'">win-x64</DotNetDupeArch>
      <DotNetDupeArch Condition="'$(Platform)' == 'Win32' OR '$(Platform)' == 'x86'">win-x86</DotNetDupeArch>
    </PropertyGroup>
    
    <ItemGroup>
      <DotNetDupeNativeDlls Include="$(SolutionDir)packages\DotNetDupe.*\runtimes\$(DotNetDupeArch)\native\*.dll" />
      <VcpkgNativeDlls Include="$(SolutionDir)vcpkg_installed\x64-windows\bin\*.dll" Condition="Exists('$(SolutionDir)vcpkg_installed\x64-windows\bin')" />
      <VcpkgNativeDllsAlt Include="$(SolutionDir)vcpkg_installed\x64-windows\x64-windows\bin\*.dll" Condition="Exists('$(SolutionDir)vcpkg_installed\x64-windows\x64-windows\bin')" />
      <VcpkgInstalledDlls Include="$(VCPKG_INSTALLATION_ROOT)\installed\x64-windows\bin\*.dll" Condition="Exists('$(VCPKG_INSTALLATION_ROOT)\installed\x64-windows\bin')" />
    </ItemGroup>

    <Copy SourceFiles="@(DotNetDupeNativeDlls)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(VcpkgNativeDlls)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="false" Condition="'@(VcpkgNativeDlls)' != ''" />
    <Copy SourceFiles="@(VcpkgNativeDllsAlt)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="false" Condition="'@(VcpkgNativeDllsAlt)' != ''" />
    <Copy SourceFiles="@(VcpkgInstalledDlls)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="false" Condition="'@(VcpkgInstalledDlls)' != ''" />
  </Target>

  <!--
    Copy all dependencies and the client app (SmartEventViewerApp) into $(OutDir)
    when building SmartEventViewerTests so integration tests can launch the server directly from $(OutDir).
  -->
  <Target Name="CopyIntegrationTestAppAndDependencies" AfterTargets="Build" Condition="'$(ProjectName)' == 'SmartEventViewerTests' OR '$(ProjectName)' == 'SmartEventViewerIntegrationTests'">
    <ItemGroup>
      <ServerFiles Include="$(SolutionDir)bin\$(Platform)\$(Configuration)\SmartEventViewerServer.*" />
      <CoreFiles Include="$(SolutionDir)bin\$(Platform)\$(Configuration)\SmartEventViewerCore.*" />
    </ItemGroup>

    <Copy SourceFiles="@(ServerFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CoreFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>

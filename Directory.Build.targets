<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- 
    Solution-level target hook to copy the latest DotNetDupe runtime DLLs
    (DotNetDupe.dll, libcrypto-4-x64.dll, libssl-4-x64.dll) from packages\DotNetDupe.3.0.7 into $(OutDir) for all projects.
  -->
  <Target Name="CopyDotNetDupeNativeBinaries" AfterTargets="Build">
    <PropertyGroup>
      <DotNetDupeArch Condition="'$(Platform)' == 'x64' OR '$(Platform)' == 'AnyCPU'">win-x64</DotNetDupeArch>
      <DotNetDupeArch Condition="'$(Platform)' == 'Win32' OR '$(Platform)' == 'x86'">win-x86</DotNetDupeArch>
    </PropertyGroup>
    
    <ItemGroup>
      <DotNetDupeNativeDlls Include="$(SolutionDir)packages\DotNetDupe.3.0.7\runtimes\$(DotNetDupeArch)\native\*.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(DotNetDupeNativeDlls)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="false" />
  </Target>
</Project>
